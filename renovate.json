{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["maven", "github-actions"],
  "ignorePaths": [
    "modpacks/**/26.2/**"
  ],
  "hostRules": [
    {
      "matchHost": "https://maven.pkg.github.com/CyclopsMC/packages",
      "token": "{{ secrets.RENOVATE_GITHUB_COM_TOKEN }}"
    },
    {
      "description": "Backstop only. The registryUrls rules below are what actually keeps Central out of the lookup path, since the Maven datasource raises an ExternalHostError on a Central 429 regardless of these flags.",
      "matchHost": "repo.maven.apache.org",
      "abortOnError": false,
      "abortIgnoreStatusCodes": [429]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": ["maven"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Cyclops mods are only published to our GitHub Packages registry",
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.cyclops.{/,}**"],
      "registryUrls": ["https://maven.pkg.github.com/CyclopsMC/packages"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.cyclops.{/,}**"],
      "groupName": "Cyclops packages"
    },
    {
      "description": "CurseForge artifacts only exist on CurseMaven",
      "matchManagers": ["maven"],
      "matchPackageNames": ["curse.maven:{/,}**"],
      "registryUrls": ["https://www.cursemaven.com/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.cobblemon:{/,}**"],
      "registryUrls": ["https://artefacts.cobblemon.com/releases/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "mezz.jei:{/,}**",
        "com.almostreliable.mods:{/,}**"
      ],
      "registryUrls": ["https://maven.blamejared.com/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "me.shedaniel:{/,}**",
        "me.shedaniel.{/,}**",
        "dev.architectury:{/,}**"
      ],
      "registryUrls": ["https://maven.shedaniel.me/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["dev.emi:{/,}**"],
      "registryUrls": ["https://maven.terraformersmc.com/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["mcjty.theoneprobe:{/,}**"],
      "registryUrls": ["https://maven.k-4u.nl/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["mekanism:{/,}**"],
      "registryUrls": ["https://modmaven.dev/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["top.theillusivec4.curios:{/,}**"],
      "registryUrls": ["https://maven.theillusivec4.top/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["thedarkcolour:{/,}**"],
      "registryUrls": ["https://thedarkcolour.github.io/KotlinForForge/"]
    },
    {
      "description": "Only registry in settings.xml serving up-to-date versions of these",
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "com.github.glitchfiend:{/,}**",
        "com.refinedmods.refinedstorage:{/,}**"
      ],
      "registryUrls": ["https://maven.creeperhost.net/"]
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.refinedmods.refinedstorage:refinedstorage-neoforge"],
      "matchFileNames": ["modpacks/**/1.21.1/**/pom.xml"],
      "allowedVersions": "/^2\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.refinedmods.refinedstorage:refinedstorage-neoforge"],
      "matchFileNames": [
        "modpacks/**/26.1*/**/pom.xml",
        "modpacks/**/26.3*/**/pom.xml"
      ],
      "allowedVersions": "/^3\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.github.glitchfiend:TerraBlender-neoforge"],
      "matchFileNames": ["modpacks/**/1.21.1/**/pom.xml"],
      "allowedVersions": "/^1\\.21-/"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.github.glitchfiend:TerraBlender-neoforge"],
      "matchFileNames": ["modpacks/**/26.1*/**/pom.xml"],
      "allowedVersions": "/^26\\.1\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.github.glitchfiend:TerraBlender-neoforge"],
      "matchFileNames": ["modpacks/**/26.3*/**/pom.xml"],
      "allowedVersions": "/^26\\.3[-.]/"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["mcjty.theoneprobe:theoneprobe"],
      "matchFileNames": ["modpacks/**/1.21.1/**/pom.xml"],
      "allowedVersions": "/^1\\.21_/"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["mcjty.theoneprobe:theoneprobe"],
      "matchFileNames": ["modpacks/**/26.1*/**/pom.xml"],
      "allowedVersions": "/^26\\.1\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["mcjty.theoneprobe:theoneprobe"],
      "matchFileNames": ["modpacks/**/26.3*/**/pom.xml"],
      "allowedVersions": "/^26\\.3_/"
    },
    {
      "description": "Architectury majors map to MC versions: 13 -> 1.21.1, 20 -> 26.1.2, 22 -> 26.3",
      "matchManagers": ["maven"],
      "matchPackageNames": ["dev.architectury:architectury-neoforge"],
      "matchFileNames": ["modpacks/**/1.21.1/**/pom.xml"],
      "allowedVersions": "/^13\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["dev.architectury:architectury-neoforge"],
      "matchFileNames": ["modpacks/**/26.1*/**/pom.xml"],
      "allowedVersions": "/^20\\./"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["dev.architectury:architectury-neoforge"],
      "matchFileNames": ["modpacks/**/26.3*/**/pom.xml"],
      "allowedVersions": "/^22\\./"
    }
  ],
  "github-actions": {
      "major": {
          "enabled": true
      }
  }
}
